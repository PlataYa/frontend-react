{
  "compilerOptions": {
    "target": "es2017",
    "lib": ["es2017", "es6", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*",
    "components/**/*",
    "context/**/*",
    "services/**/*",
    "dto/**/*",
    "utils/**/*",
    "index.js"
  ],
  "exclude": [
    "node_modules",
    "app/**/*",
    "android",
    "ios"
  ]
}
